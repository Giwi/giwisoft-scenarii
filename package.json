{
  "name": "scenarii",
  "version": "1.4.1",
  "description": "Execute periodic YAML-defined scenarios to test web applications",
  "main": "dist/index.js",
  "bin": {
    "scenarii": "dist/index.js"
  },
  "scripts": {
    "build": "tsc && npm run build:frontend",
    "build:backend": "tsc",
    "build:frontend": "cd frontend && npx ng build",
    "start": "node dist/index.js",
    "start:server": "node dist/index.js server",
    "dev": "npx concurrently -n server,frontend -c blue,green \"tsx src/index.ts server\" \"cd frontend && npx ng serve --proxy-config proxy.conf.json\"",
    "dev:server": "tsx src/index.ts server",
    "dev:frontend": "cd frontend && npx ng serve --proxy-config proxy.conf.json",
    "dev:once": "tsx src/index.ts --once scenarios/lusk.yml",
    "dev:scenario": "npx chokidar 'scenarios/**/*.yml' -c 'npx tsx src/index.ts --once {path}'",
    "lint": "tsc --noEmit",
    "check:i18n": "node scripts/check-i18n-keys.mjs",
    "test": "npm run build:backend && tsc -p tests/tsconfig.json && node --experimental-test-module-mocks --test 'dist-test/tests/**/*.test.js'",
    "screenshots": "tsx take-screenshots.ts",
    "package": "npm run build && sh build-container.sh"
  },
  "dependencies": {
    "@lightpanda/browser": "^1.6.0",
    "better-sqlite3": "^13.0.3",
    "commander": "^15.0.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "js-yaml": "^5.4.2",
    "node-cron": "^4.6.0",
    "picocolors": "^1.1.1",
    "pino": "^10.3.1",
    "playwright-core": "^1.63.0",
    "qrcode": "^1.5.4",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.6.3",
    "@types/node-cron": "^3.0.11",
    "@types/pino": "^7.0.4",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.18.2",
    "chokidar-cli": "^3.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "optionalDependencies": {
    "@emnapi/core": "^1.11.3",
    "@emnapi/runtime": "^1.11.3",
    "@emnapi/wasi-threads": "^2.1.0"
  }
}
